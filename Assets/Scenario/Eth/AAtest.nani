; layer blur (focus pull: blur bg, keep char sharp)

@rtfx obj:lyen prop:_BlurLod to:3 duration:1.2

; feathered ellipse vignette on one layer, screen-space
@rtfx obj:lyen prop:_MaskSpace to:1 duration:1
@rtfx obj:fen prop:_MaskMode to:2 duration:1

