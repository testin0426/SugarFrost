@if num==0
    @if d==0
        @if port==1
            @goto #0other
            @stop
        @if trace==1
            @set loc1="D"
            @set port=1
            @goto Eth/situ/tea/runtime/port11
            @stop
        @if trace==2
            @set loc2="D"
            @set port=1
            @goto Eth/situ/tea/runtime/teacop
            @stop
        @if trace==3
            @set loc3="D"
            @set port=1
            @goto Eth/situ/tea/runtime/teaclose
    @if d==1
@if d==1
    @if p=="lyen"
        @goto Eth/situ/market/runtime/cyan
        @stop
    @if p=="cyan"
        @goto Eth/situ/runtime/pwc
        @stop

# 0other
@despawnAll
@playUIFX threshold:0.0 duration:0.01
