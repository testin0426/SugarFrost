
# d0choiceall
@set trace=trace+1
@playUIFX threshold:1.0 duration:0.1
@playUIFX threshold:0.0 duration:1.0 !wait
@if trace==1
    @back mapbase id:map scale:0.72
@if trace==2
    @if loc1=="D"
        @back id:map appearance:mapport1 scale:0.72
    @if loc1=="C"

    @if loc1=="B"
        @back id:map appearance:mapmarket1 scale:0.72
@if trace==3
    @if loc1=="D"
        @if loc2=="C"


@if trace==4
    @if market==1
        @if port==0
            @if mansion==0
            ; 


@addChoice 往雪花那边走走看 if:port==0 set:now=3 goto:Eth/tea/portallo

@addChoice 去渡口 if:port>0 set:now=before, goto:Eth/tea/portallo

@addChoice 下面那个糖雪球是？ if:market==0 set:now=1 goto:Eth/market/marketallo

@addChoice 去集市 if:market>0 set:now=before goto:Eth/market/marketallo

@addChoice "<b>看不懂一点咋办？</b>" if:count==0 goto:Eth/situ/justify

@addChoice "<b>发呆...</b>" if:count>0 goto:Eth/situ/justify

@addChoice 问问路人右上方是？ if:mansion==0 set:now=2 goto:Eth/mansion/mansionallo

@addChoice 去公馆 if:mansion>0 set:now=before goto:Eth/mansion/mansionallo

@addChoice 凭借记忆去商会分部 set:now=0 goto:Eth/situ/river

@stop





# distancecaculate
@if before==0
    @if now=1
        @set trace=trace+1
        @goto Eth/situ/market
    @if now==2
        @set trace=trace+2
        @goto Eth/situ/port
    @if now=3
        @set trace=trace+4
        @goto Eth/situ/mansion


@if before==1
