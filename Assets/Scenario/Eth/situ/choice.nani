        @set trace=trace+2
        @goto Eth/situ/jiang
    @if now==1
        @set trace=trace+2
        @goto Eth/situ/market
    @if now==3
        @set trace=trace+2
        @goto Eth/situ/mansion


@if before==3
    @if now==0
        @set trace=trace+4
        @goto Eth/situ/jiang
    @if now==1
        @set trace=trace+4
        @goto Eth/situ/market
    @if now=2
        @set trace=trace+2
        @goto Eth/situ/port




