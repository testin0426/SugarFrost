    characterSequence: "\u66A8\u6B81\u5565.\u751F\u65E5\u5FEB\u4E50\u4F60\uFF0C19\u5C81\u793C\u7269\u4EE5\u8FD9\u4E2A\u5F62\u5F0F\u5448\u73B0\u6211\u4E5F\u662F\u6CA1\u62DB\u4E86\u54E5\u4EEC\u4E0D\u5C2C\u804A\u4E00\u4E9B\u7535\u5B50\u5C0F\u732Bhey
